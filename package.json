{
  "name": "@rizamo/ai-sdk",
  "version": "0.1.1",
  "description": "Rizamo tools for the Vercel AI SDK: publish, schedule and measure social posts on Instagram, Facebook, TikTok, Threads, LinkedIn and YouTube, and answer comments and messages.",
  "keywords": [
    "rizamo",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai",
    "tools",
    "agents",
    "social-media",
    "social-media-api",
    "instagram",
    "tiktok",
    "linkedin",
    "youtube"
  ],
  "homepage": "https://docs.rizamo.com/frameworks/vercel-ai-sdk",
  "bugs": {
    "url": "https://github.com/rizamohq/rizamo-ai-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizamohq/rizamo-ai-sdk.git"
  },
  "license": "MIT",
  "author": "Rizamo <hi@rizamo.com> (https://rizamo.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "rizamo": "^1.2.0"
  },
  "peerDependencies": {
    "ai": ">=6",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.177",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  }
}
